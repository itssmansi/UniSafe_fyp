    </mxCell><mxCell id="cell_159" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;" value="&lt;div style=&quot;line-height:1.7;font-size:16px;color:#111;&quot;&gt;&lt;b&gt;• Mobile Client:&lt;/b&gt; Flutter (Dart 3)&lt;br/&gt;&lt;b&gt;• Web Portal:&lt;/b&gt; React 18, Vite, Tailwind CSS&lt;br/&gt;&lt;b&gt;• Cloud BaaS:&lt;/b&gt; Supabase Platform&lt;br/&gt;&lt;b&gt;• Relational DB:&lt;/b&gt; PostgreSQL 15.1+&lt;br/&gt;&lt;b&gt;• Vector Index:&lt;/b&gt; pgvector (512-d HNSW)&lt;br/&gt;&lt;b&gt;• Face Biometrics:&lt;/b&gt; InsightFace / FaceNet&lt;br/&gt;&lt;b&gt;• Match Threshold:&lt;/b&gt; Cosine Similarity ≥ 0.85&lt;br/&gt;&lt;b&gt;• Identity e-KYC:&lt;/b&gt; Sandbox.co.in (DigiLocker)&lt;br/&gt;&lt;b&gt;• Push Delivery:&lt;/b&gt; Firebase Cloud Messaging&lt;br/&gt;&lt;b&gt;• Emergency SMS:&lt;/b&gt; Pingram Gateway API&lt;br/&gt;&lt;b&gt;• Geospatial GIS:&lt;/b&gt; OpenStreetMap &amp; MapLibre&lt;br/&gt;&lt;b&gt;• Security Model:&lt;/b&gt; JWT + Row-Level Security&lt;/div&gt;" vertex="1">
      <mxGeometry x="570" y="100" width="420" height="380" as="geometry" />
    </mxCell><mxCell id="cell_160" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=top;spacing=14;" value="&lt;div style=&quot;line-height:1.45;font-size:15px;color:#222;&quot;&gt;&lt;b style=&quot;color:#b45309;font-size:17px;&quot;&gt;Zero-Trust Data Isolation:&lt;/b&gt;&lt;br/&gt;All biometric vectors, Aadhaar e-KYC tokens, and civic telemetry are guarded by PostgreSQL Row-Level Security (RLS) policies.&lt;/div&gt;" vertex="1">
      <mxGeometry x="570" y="505" width="420" height="135" as="geometry" />
    </mxCell><mxCell id="cell_161" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacing=14;" value="&lt;div style=&quot;line-height:1.45;font-size:15px;color:#222;&quot;&gt;&lt;b style=&quot;color:#1d3557;font-size:17px;&quot;&gt;Two-Way Verification Protocol:&lt;/b&gt;&lt;br/&gt;Field officers must upload work-done proof photos. Ticket closes only after citizen conducts on-site camera re-audit within 100m GPS radius.&lt;/div&gt;" vertex="1">
