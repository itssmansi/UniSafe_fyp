# ==============================================================================
# UniSafe - Environment Configuration Template
# Copy this file to `.env` and populate with real keys.
# DO NOT COMMIT `.env` TO VERSION CONTROL.
# ==============================================================================

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Pingram SMS Service (for OTP & Journey Tracking SMS)
PINGRAM_API_KEY=your_pingram_secret_key
PINGRAM_SMS_TYPE=un1safe_otp
PINGRAM_BASE_URL=https://api.pingram.io

# Sandbox.co.in DigiLocker KYC API Credentials
SANDBOX_KEY=your_sandbox_api_key
SANDBOX_SECRET=your_sandbox_api_secret
SANDBOX_BASE=https://api.sandbox.co.in

# Google Maps API (Street View & Interactive Map)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Journey Tracking Public URL
TRACKING_BASE_URL=https://unisafe-e08e5.web.app/track
