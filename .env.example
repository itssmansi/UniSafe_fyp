# UniSafe Project Environment Configuration

# TomTom Traffic API Key (Real-Time Live Traffic Flow Overlays)
# Obtain a free key at: https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# Pingram SMS API Configuration (Dispatched via Supabase Edge Functions)
# Used for Women's Safety SOS distress alerts, trusted-contact live-tracking SMS, and OTPs.
# Set this secret in Supabase using the CLI:
#   supabase secrets set PINGRAM_API_KEY=your_pingram_api_key_here --project-ref wcksscwgeoysnqiluxoh
# Optional: Regional base URL (default is US: https://api.pingram.io, EU: https://api.eu.pingram.io, CA: https://api.ca.pingram.io)
#   supabase secrets set PINGRAM_BASE_URL=https://api.pingram.io --project-ref wcksscwgeoysnqiluxoh
# Optional: Pingram SMS Type identifier (default: un1safe_otp)
#   supabase secrets set PINGRAM_SMS_TYPE=un1safe_otp --project-ref wcksscwgeoysnqiluxoh
PINGRAM_API_KEY=your_pingram_api_key_here
PINGRAM_BASE_URL=https://api.pingram.io
PINGRAM_SMS_TYPE=un1safe_otp
